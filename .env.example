NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=ecommerce_api_db

DATABASE_URL="mysql://your_mysql_user:your_mysql_password@127.0.0.1:3306/ecommerce_api_db"

# Comma-separated list for the allowed frontend origins.
# Example: http://localhost:3000,http://localhost:5173,https://your-frontend.com
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-secret
MIDTRANS_WEBHOOK_SECRET=replace-with-midtrans-secret
XENDIT_WEBHOOK_TOKEN=replace-with-xendit-token
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret